# ===== Frontend (GitHub Pages / local dev) =====
# JSONBin.io API Key for Share Standings feature (local/browser-only mode)
# Get your free API key at https://jsonbin.io (10k requests/month on free tier)
VITE_JSONBIN_API_KEY=your_api_key_here

# Point the app at a tournament server instead of browser storage.
# The Docker image sets VITE_API_URL=/api and VITE_BASE=/ automatically.
# VITE_API_URL=http://localhost:3000/api

# ===== Docker stack (docker-compose.yml) =====
# Port the web app is published on
WEB_PORT=8090
POSTGRES_DB=dune_tournament
POSTGRES_USER=dune
POSTGRES_PASSWORD=change-me
# Organizer token required for every change (create tournaments, enter results, settings)
ADMIN_TOKEN=change-me-too
